// MiniGit (SPEC-v2.txt): a minimal version control system over .minigit/.
import env
import fs
import process

let FNV_OFFSET = 1469598103934665603
let FNV_PRIME = 1099511628211

// MiniHash: FNV-1a over the raw bytes, wrapping at 64 bits, as 16 lowercase hex digits
fn minihash(content: String) -> String = {
  let h = bytes.to_list(bytes.from_string(content))
    |> list.fold(FNV_OFFSET, (acc, b) => int.wrap_mul(int.bxor(acc, b), FNV_PRIME))
  string.pad_start(int.to_hex(h), 16, "0")
}

// ---- Helpers ----

effect fn die(msg: String) -> Unit = {
  println(msg)
  process.exit(1)
}

fn commit_path(hash: String) -> String = ".minigit/commits/${hash}"

effect fn read_head() -> String = string.trim(fs.read_text(".minigit/HEAD")!)

effect fn read_index() -> List[String] =
  string.lines(fs.read_text(".minigit/index")!) |> list.filter((s) => s != "")

fn parse_field(content: String, field: String) -> String = {
  let prefix = field + ": "
  match string.lines(content) |> list.find((line) => string.starts_with(line, prefix)) {
    some(line) => string.drop(line, string.len(prefix)),
    none => "",
  }
}

// The `files:` section of a commit as (filename, blob hash) pairs
fn parse_commit_files(content: String) -> List[(String, String)] =
  match list.get(string.split(content, "files:\n"), 1) {
    none => [],
    some(section) => string.lines(section) |> list.filter_map((line) => {
      let p = string.split(string.trim(line), " ")
      let name = list.get(p, 0) ?? ""
      let hash = list.get(p, 1) ?? ""
      if name != "" and hash != "" then some((name, hash)) else none
    }),
  }

fn blob_of(files: List[(String, String)], name: String) -> String =
  match list.find(files, ((n, _)) => n == name) {
    some((_, hash)) => hash,
    none => "",
  }

effect fn print_header(hash: String, content: String) -> Unit = {
  println("commit ${hash}")
  println("Date: ${parse_field(content, "timestamp")}")
  println("Message: ${parse_field(content, "message")}")
}

// ---- Commands ----

effect fn cmd_init() -> Unit =
  if fs.exists(".minigit") then println("Repository already initialized")
  else {
    fs.mkdir_p(".minigit/objects")!
    fs.mkdir_p(".minigit/commits")!
    fs.write_text(".minigit/index", "")!
    fs.write_text(".minigit/HEAD", "")!
  }

effect fn cmd_add(filename: String) -> Unit =
  if not fs.exists(filename) then die("File not found")!
  else {
    let content = fs.read_text(filename)!
    fs.write_text(".minigit/objects/${minihash(content)}", content)!
    let staged = read_index()!
    if not list.contains(staged, filename) then fs.write_text(".minigit/index", list.join(staged + [filename], "\n"))!
    else ()
  }

effect fn cmd_commit(message: String) -> Unit = {
  let staged = read_index()!
  if list.is_empty(staged) then die("Nothing to commit")!
  else {
    let head = read_head()!
    let parent = if head == "" then "NONE" else head
    let prev_files = if head == "" then [] else parse_commit_files(fs.read_text(commit_path(head))!)
    let staged_pairs = staged |> list.map((f) => (f, minihash(fs.read_text(f)!)))!
    let kept = prev_files |> list.filter(((name, _)) => not list.contains(staged, name))
    let files_str = (kept + staged_pairs)
      |> list.sort_by(((name, _)) => name)
      |> list.map(((name, hash)) => "${name} ${hash}")
      |> list.join("\n")
    let ts = int.to_string(datetime.now())
    let commit_content = "parent: ${parent}\ntimestamp: ${ts}\nmessage: ${message}\nfiles:\n${files_str}\n"
    let commit_hash = minihash(commit_content)
    fs.write_text(commit_path(commit_hash), commit_content)!
    fs.write_text(".minigit/HEAD", commit_hash)!
    fs.write_text(".minigit/index", "")!
    println("Committed ${commit_hash}")
  }
}

effect fn cmd_status() -> Unit = {
  let staged = read_index()!
  println("Staged files:")
  if list.is_empty(staged) then println("(none)")
  else {
    for f in staged {
      println(f)
    }
  }
}

effect fn cmd_log() -> Unit = {
  let head = read_head()!
  if head == "" then println("No commits") else print_log(head)!
}

effect fn print_log(hash: String) -> Unit =
  if hash == "" or hash == "NONE" then ()
  else {
    let content = fs.read_text(commit_path(hash))!
    print_header(hash, content)!
    println("")
    print_log(parse_field(content, "parent"))!
  }

effect fn cmd_diff(hash1: String, hash2: String) -> Unit =
  if not fs.exists(commit_path(hash1)) or not fs.exists(commit_path(hash2)) then die("Invalid commit")!
  else {
    let files1 = parse_commit_files(fs.read_text(commit_path(hash1))!)
    let files2 = parse_commit_files(fs.read_text(commit_path(hash2))!)
    let names = (files1 + files2) |> list.map(((name, _)) => name) |> list.unique |> list.sort
    for name in names {
      let h1 = blob_of(files1, name)
      let h2 = blob_of(files2, name)
      if h1 == "" and h2 != "" then println("Added: ${name}")
      else if h1 != "" and h2 == "" then println("Removed: ${name}")
      else if h1 != h2 then println("Modified: ${name}")
      else ()
    }
  }

effect fn cmd_checkout(hash: String) -> Unit =
  if not fs.exists(commit_path(hash)) then die("Invalid commit")!
  else {
    let files = parse_commit_files(fs.read_text(commit_path(hash))!)
    for (name, blob) in files {
      fs.write_text(name, fs.read_text(".minigit/objects/${blob}")!)!
    }
    fs.write_text(".minigit/HEAD", hash)!
    fs.write_text(".minigit/index", "")!
    println("Checked out ${hash}")
  }

effect fn cmd_reset(hash: String) -> Unit =
  if not fs.exists(commit_path(hash)) then die("Invalid commit")!
  else {
    fs.write_text(".minigit/HEAD", hash)!
    fs.write_text(".minigit/index", "")!
    println("Reset to ${hash}")
  }

effect fn cmd_rm(filename: String) -> Unit = {
  let staged = read_index()!
  if not list.contains(staged, filename) then die("File not in index")!
  else fs.write_text(".minigit/index", staged |> list.filter((f) => f != filename) |> list.join("\n"))!
}

effect fn cmd_show(hash: String) -> Unit =
  if not fs.exists(commit_path(hash)) then die("Invalid commit")!
  else {
    let content = fs.read_text(commit_path(hash))!
    print_header(hash, content)!
    println("Files:")
    for (name, blob) in parse_commit_files(content) {
      println("  ${name} ${blob}")
    }
  }

// ---- Entry point ----

// The i-th program argument (the command is 0), or a usage error.
effect fn arg(args: List[String], i: Int) -> String = match list.get(args, i) {
  some(v) => v,
  none => {
    die("Usage: minigit <command> [args]")!
    ""
  },
}

effect fn main() -> Unit = {
  let args = env.args()
  let cmd = list.get(args, 0) ?? ""
  match cmd {
    "init" => cmd_init()!,
    "add" => cmd_add(arg(args, 1)!)!,
    "commit" => cmd_commit(arg(args, 2)!)!,
    "log" => cmd_log()!,
    "status" => cmd_status()!,
    "diff" => cmd_diff(arg(args, 1)!, arg(args, 2)!)!,
    "checkout" => cmd_checkout(arg(args, 1)!)!,
    "reset" => cmd_reset(arg(args, 1)!)!,
    "rm" => cmd_rm(arg(args, 1)!)!,
    "show" => cmd_show(arg(args, 1)!)!,
    _ => die("Unknown command: ${cmd}")!,
  }
}
