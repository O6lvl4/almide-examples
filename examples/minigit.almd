// MiniGit, an early version: init, add, commit and log over .minigit/.
// The full v1+v2 implementation is minigit-bench/minigit.almd.
import env
import fs

// ---- Hash ----

let FNV_OFFSET = 1469598103934665603
let FNV_PRIME = 1099511628211

// MiniHash: FNV-1a over the bytes, wrapping at 64 bits, as 16 lowercase hex digits
fn minihash(data: List[Int]) -> String = {
  let h = data |> list.fold(FNV_OFFSET, (acc, b) => int.wrap_mul(int.bxor(acc, b), FNV_PRIME))
  string.pad_start(int.to_hex(h), 16, "0")
}

effect fn hash_file(path: String) -> String = minihash(bytes.to_list(fs.read_bytes(path)!))

// ---- Repository ----

let REPO_PATH = ".minigit"
let OBJECTS_PATH = ".minigit/objects"
let COMMITS_PATH = ".minigit/commits"
let INDEX_PATH = ".minigit/index"
let HEAD_PATH = ".minigit/HEAD"

// ---- Commands ----

effect fn init() -> Unit =
  if fs.exists(REPO_PATH) then println("Repository already initialized")
  else {
    fs.mkdir_p(OBJECTS_PATH)!
    fs.mkdir_p(COMMITS_PATH)!
    fs.write_text(INDEX_PATH, "")!
    fs.write_text(HEAD_PATH, "")!
  }

effect fn add(filename: String) -> Unit = {
  guard fs.exists(filename) else err("File not found: ${filename}")
  let hash = hash_file(filename)!
  fs.write_bytes("${OBJECTS_PATH}/${hash}", fs.read_bytes(filename)!)!
  let index = read_index()!
  if not list.contains(index, filename) then fs.append_text(INDEX_PATH, "${filename}\n")! else ()
}

effect fn commit(message: String) -> Unit = {
  let index = read_index()!
  guard not list.is_empty(index) else err("Nothing to commit")
  let head = string.trim(fs.read_text(HEAD_PATH)!)
  let parent = if head == "" then "NONE" else head
  let timestamp = datetime.now()
  let file_entries = list.sort(index) |> list.map((f) => "${f} ${hash_file(f)!}")!
  let commit_content = list.join([
    "parent: ${parent}",
    "timestamp: ${timestamp}",
    "message: ${message}",
    "files:",
  ] + file_entries, "\n")
  let commit_hash = minihash(bytes.to_list(bytes.from_string(commit_content)))
  fs.write_text("${COMMITS_PATH}/${commit_hash}", commit_content)!
  fs.write_text(HEAD_PATH, commit_hash)!
  fs.write_text(INDEX_PATH, "")!
  println("Committed ${commit_hash}")
}

effect fn log() -> Unit = {
  let head = string.trim(fs.read_text(HEAD_PATH)!)
  if head == "" then println("No commits") else log_from(head)!
}

effect fn log_from(current: String) -> Unit =
  if current == "" or current == "NONE" then ()
  else {
    let info = parse_commit(fs.read_text("${COMMITS_PATH}/${current}")!)
    println("commit ${current}")
    println("Date: ${info.timestamp}")
    println("Message: ${info.message}")
    println("")
    log_from(info.parent)!
  }

// ---- Helpers ----

effect fn read_index() -> List[String] =
  string.split(string.trim(fs.read_text(INDEX_PATH)!), "\n") |> list.filter((s) => s != "")

type CommitInfo = {
  parent: String,
  timestamp: String,
  message: String,
}

fn parse_commit(content: String) -> CommitInfo = {
  let lines = string.split(content, "\n")
  CommitInfo {
    parent: extract_field(lines, "parent: ", "NONE"),
    timestamp: extract_field(lines, "timestamp: ", "0"),
    message: extract_field(lines, "message: ", ""),
  }
}

fn extract_field(lines: List[String], prefix: String, default_val: String) -> String =
  match list.find(lines, (l) => string.starts_with(l, prefix)) {
    some(line) => string.drop(line, string.len(prefix)),
    none => default_val,
  }

// ---- Main ----

effect fn main() -> Unit = {
  let args = env.args()
  match list.get(args, 0) {
    some("init") => init()!,
    some("add") => match list.get(args, 1) {
      some(f) => add(f)!,
      none => println("Usage: minigit add <file>"),
    },
    some("commit") => match (list.get(args, 1), list.get(args, 2)) {
      (some("-m"), some(m)) => commit(m)!,
      _ => println("Usage: minigit commit -m <message>"),
    },
    some("log") => log()!,
    some(other) => println("Unknown command: ${other}"),
    none => println("Usage: minigit <command>"),
  }
}

// ---- Tests ----

test "minihash produces 16-char hex" {
  let hash = minihash(bytes.to_list(bytes.from_string("hello")))
  assert_eq(string.len(hash), 16)
}

test "minihash is deterministic" {
  let h1 = minihash(bytes.to_list(bytes.from_string("test")))
  let h2 = minihash(bytes.to_list(bytes.from_string("test")))
  assert_eq(h1, h2)
}

test "minihash differs for different input" {
  let h1 = minihash(bytes.to_list(bytes.from_string("aaa")))
  let h2 = minihash(bytes.to_list(bytes.from_string("bbb")))
  assert_ne(h1, h2)
}

test "minihash is 64-bit FNV-1a" {
  assert_eq(minihash([]), "cbf29ce484222325")
  assert_eq(minihash(bytes.to_list(bytes.from_string("a"))), "af63dc4c8601ec8c")
}

test "parse_commit extracts fields" {
  let content = "parent: NONE\ntimestamp: 1234567890\nmessage: initial\nfiles:\nfoo.txt abc123"
  let info = parse_commit(content)
  assert_eq(info.parent, "NONE")
  assert_eq(info.timestamp, "1234567890")
  assert_eq(info.message, "initial")
}
